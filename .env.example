APP_ENV=development
APP_NAME=VECTRAID
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vectraid
POSTGRES_USER=vectraid
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://vectraid:change_me@localhost:5432/vectraid

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/
MALWAREBAZAAR_API_URL=https://mb-api.abuse.ch/api/v1/

TI_REQUEST_TIMEOUT=15
TI_REQUEST_MAX_RETRIES=2
TI_RATE_LIMIT_PER_MINUTE=60

SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=50

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
